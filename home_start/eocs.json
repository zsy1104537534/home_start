[
  {
    "type": "effect_on_condition",
    "id": "EOC_home_start",
    "//": "Start script.  1) A short popup so the player knows where they are.  2) Teleport onto a bed in the flat: the engine's own start placement tends to drop the player in a corridor or at the map edge.  The bed search radius grows in stages (6 -> 12 -> 24 tiles) on purpose: u_location_variable scans its bounding box in row-major order and stops at the first match, so a single large radius always lands on the north-west-most bed of the floor, which can be a neighbouring flat or even another building.  Bathtub is the last fallback.  3) Hand the player a crowbar (into the inventory, so a locked door is never a dead end) and drop a sewing kit on the tile they wake up on.  4) Cast the vanilla BEGONE_SHADOW spell on every monster within 60 tiles that is indoors, and on everything within 20 tiles, to clear the player's own floor.  Does not touch hunger or thirst: the character starts in a normal state.",
    "eoc_type": "ACTIVATION",
    "effect": [
      {
        "u_message": "You sit up in bed, your head still swimming.\n\nOutside the window, there are more of them than there were a few days ago.",
        "popup": true
      },
      {
        "u_location_variable": { "u_val": "wake_spot" },
        "furniture": "f_bed",
        "target_min_radius": 0,
        "target_max_radius": 6,
        "true_eocs": [ { "id": "EOC_wake_tp_6", "effect": [ { "u_teleport": { "u_val": "wake_spot" }, "force": true } ] } ],
        "false_eocs": [
          {
            "id": "EOC_wake_bed_12",
            "effect": [
              {
                "u_location_variable": { "u_val": "wake_spot" },
                "furniture": "f_bed",
                "target_min_radius": 0,
                "target_max_radius": 12,
                "true_eocs": [ { "id": "EOC_wake_tp_12", "effect": [ { "u_teleport": { "u_val": "wake_spot" }, "force": true } ] } ],
                "false_eocs": [
                  {
                    "id": "EOC_wake_bed_24",
                    "effect": [
                      {
                        "u_location_variable": { "u_val": "wake_spot" },
                        "furniture": "f_bed",
                        "target_min_radius": 0,
                        "target_max_radius": 24,
                        "true_eocs": [ { "id": "EOC_wake_tp_24", "effect": [ { "u_teleport": { "u_val": "wake_spot" }, "force": true } ] } ],
                        "false_eocs": [
                          {
                            "id": "EOC_wake_bath_24",
                            "effect": [
                              {
                                "u_location_variable": { "u_val": "wake_spot" },
                                "furniture": "f_bathtub",
                                "target_min_radius": 0,
                                "target_max_radius": 24,
                                "true_eocs": [ { "id": "EOC_wake_tp_bath", "effect": [ { "u_teleport": { "u_val": "wake_spot" }, "force": true } ] } ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      { "u_spawn_item": "crowbar", "suppress_message": true },
      { "map_spawn_item": "sewing_kit" },
      {
        "u_run_monster_eocs": [
          {
            "id": "EOC_home_banish_indoor",
            "condition": { "not": "u_is_outside" },
            "effect": [ { "u_cast_spell": { "id": "BEGONE_SHADOW" } } ]
          }
        ],
        "monster_range": 60
      },
      {
        "u_run_monster_eocs": [ { "id": "EOC_home_banish_near", "effect": [ { "u_cast_spell": { "id": "BEGONE_SHADOW" } } ] } ],
        "monster_range": 20
      }
    ]
  }
]
